# Quoridor Server Configuration
# Copy this file to .env and fill in real values

# MongoDB connection URL
# Local: mongodb://localhost:27017/quoridor
# Atlas: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/quoridor
MONGO_URI=mongodb://localhost:27017/quoridor

# Redis connection URL (required for real deployments; falls back to in-memory store when down)
REDIS_URL=redis://localhost:6379

# Session secret (generate a random 64+ char string for production!)
# Example: openssl rand -hex 32
SESSION_SECRET=change_me_to_random_secret

# Server port
PORT=3000

# Environment (development/production)
NODE_ENV=development

# Allowed origins for CORS (comma-separated, for production)
# ALLOWED_ORIGINS=https://playquor.org

# Sentry DSN (error tracking) - get from https://sentry.io
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@xxxxx.ingest.de.sentry.io/xxxxxx

# Socket.IO Admin UI credentials (https://admin.socket.io). Active only when both are set.
# Note: production docker-compose.yml does not pass these to the container.
# SOCKET_ADMIN_USERNAME=admin
# SOCKET_ADMIN_PASSWORD=your_password

# ---- Bots (server-side matchmaking fallback + presence simulation) ----
BOTS_ENABLED=false
BOT_RANKED_ENABLED=false
BOT_FALLBACK_MIN_WAIT_MS=15000
BOT_FALLBACK_MAX_WAIT_MS=25000
BOT_MAX_ACTIVE_GAMES=15
BOT_MOVE_MIN_DELAY_MS=800
BOT_MOVE_MAX_DELAY_MS=2500
BOT_MAX_RECENT_MATCHES=3
BOT_RECENT_WINDOW_MS=3600000

# Password used to create/seed bot accounts (src/simulation/PopulationManager.js)
# BOT_ACCOUNT_PASSWORD=change_me

# Resend API key for password reset emails (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=noreply@playquor.org
# SITE_URL=https://playquor.org

# Directory for uploaded avatars (set by Dockerfile to /app/avatars for the container)
# AVATARS_DIR=avatars